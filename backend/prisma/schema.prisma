generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  PARTNER
  ADMIN
}

enum HotelStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  name       String
  phone      String?
  password   String
  avatar     String?
  role       Role        @default(GUEST)
  isVerified Boolean     @default(false)
  bookings   Booking[]
  hotels     Hotel[]     @relation("PartnerHotels")
  reviews    Review[]
  savedHotels SavedHotel[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Hotel {
  id           String      @id @default(uuid())
  name         String
  city         String
  address      String
  description  String
  images       String      @default("[]")
  amenities    String      @default("[]")
  rating       Float       @default(0)
  starRating   Int         @default(3)
  propertyType String      @default("Hotel")
  policies     String      @default("{}")
  commission   Float       @default(20.0)
  isFeatured   Boolean     @default(false)
  isVerified   Boolean     @default(false)
  latitude     Float?
  longitude    Float?
  partnerId    String?
  partner      User?       @relation("PartnerHotels", fields: [partnerId], references: [id])
  status       HotelStatus @default(ACTIVE)
  rooms        Room[]
  reviews      Review[]
  savedBy      SavedHotel[]
  bookings     Booking[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([city])
  @@index([status])
}

model Room {
  id           String             @id @default(uuid())
  hotelId      String
  hotel        Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  type         String
  capacity     Int
  basePrice    Float
  totalRooms   Int
  amenities    String             @default("[]")
  images       String             @default("[]")
  bookings     Booking[]
  availability RoomAvailability[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([hotelId])
}

model RoomAvailability {
  id             String   @id @default(uuid())
  roomId         String
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date           DateTime
  price          Float
  roomsAvailable Int

  @@unique([roomId, date])
  @@index([roomId, date])
}

model Booking {
  id              String        @id @default(uuid())
  bookingRef      String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  roomId          String
  room            Room          @relation(fields: [roomId], references: [id])
  hotelId         String
  hotel           Hotel         @relation(fields: [hotelId], references: [id])
  hotelName       String
  checkin         DateTime
  checkout        DateTime
  guests          Int
  totalPrice      Float
  taxes           Float
  platformFee     Float?
  hotelPayout     Float?
  paymentStatus   String        @default("PENDING")
  status          BookingStatus @default(PENDING)
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  specialRequests String?
  paymentId       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([roomId])
  @@index([hotelId])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  rating    Int
  title     String?
  comment   String
  reply     String?
  createdAt DateTime @default(now())

  @@unique([userId, hotelId])
  @@index([hotelId])
}

model SavedHotel {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, hotelId])
}

model Offer {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String
  discount    Float
  minBooking  Float?
  maxDiscount Float?
  validFrom   DateTime
  validTill   DateTime
  isActive    Boolean  @default(true)
  usageLimit  Int?
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
}

model City {
  id         String  @id @default(uuid())
  name       String  @unique
  state      String
  image      String
  hotelCount Int     @default(0)
  isPopular  Boolean @default(false)
}

model Payout {
  id          String    @id @default(uuid())
  partnerId   String
  amount      Float
  period      String
  status      String    @default("PENDING")
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}